# Streamlit Secrets Template
# 
# Copy these to Streamlit Cloud's Secrets management section
# Go to: https://share.streamlit.io/ -> Your App -> Settings -> Secrets
#
# Add in TOML format:

# Optional API Keys (for enhanced scraping)
KEEPA_API_KEY = "your_key_here"
SERPAPI_KEY = "your_key_here"

# Scraping Configuration
SCRAPE_DELAY = 3
MAX_RETRIES = 3
TIMEOUT = 30
HEADLESS = true

# Database Path (relative to app root)
DATABASE_PATH = "data/price_history.db"

# Logging
LOG_LEVEL = "INFO"
